# ── Copy this file to .env and fill in your values ──────────────────────────

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# Whisper model size: tiny | base | small | medium | large
# "small" is the minimum for reliable Arabic transcription
# "medium" is best if you have enough RAM (it uses ~5 GB)
WHISPER_MODEL=small

# Ollama settings (running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# OCR fallback settings
OCR_FRAME_INTERVAL=2          # Extract 1 frame every N seconds
OCR_LANG=eng                  # Tesseract language — English (burned-in subtitles)
OCR_CROP_BOTTOM_PERCENT=0.20  # Crop bottom 20% of frame for subtitles

# Browser automation
CHROME_USER_DATA=
CHROME_PROFILE=
